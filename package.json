{
  "name": "justbeingmercedes",
  "private": true,
  "type": "module",
  "scripts": {
    "validate": "node scripts/validate.mjs",
    "screenshots": "node scripts/validate.mjs --screenshots",
    "deploy": "wrangler pages deploy public --project-name justbeingmercedes --branch main --commit-dirty=true",
    "test": "node scripts/e2e-upload.mjs",
    "validate:static": "node scripts/validate.mjs --static",
    "validate:workflows": "node scripts/validate-workflows.mjs && node scripts/validate-workflows.mjs --self-test",
    "validate:gate": "node scripts/production-gate.mjs --self-test"
  },
  "devDependencies": {
    "playwright": "^1.55.0",
    "wrangler": "^4.0.0"
  }
}
